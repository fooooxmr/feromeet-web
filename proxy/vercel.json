{
  "framework": null,
  "functions": {
    "api/proxy/**/*.ts": {
      "maxDuration": 10
    },
    "api/ws-chat.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/proxy/:path*",
      "destination": "/api/proxy/bridge?upstream=:path*"
    },
    {
      "source": "/api/ws-chat/:path*",
      "destination": "/api/ws-chat?upstream=/api/ws-chat/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
